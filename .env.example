# ============================================================
#  环境变量模板 —— 复制为 .env 并填入真实值（.env 不进 git）
# ============================================================
# 说明：
# - 本地离线开发：只填 Clerk + Anthropic 即可；不设 DATABASE_URL / S3_*
#   时，应用自动回退到本地文件存储（content/ + recordings/）。
# - 生产（EC2 + Postgres 容器 + S3）：填全部，但 AWS 密钥见下方说明。

# ---------- 鉴权 Clerk ----------
# 本地用 pk_test_/sk_test_（开发实例），线上用 pk_live_/sk_live_（生产实例）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# ---------- LLM（Anthropic）----------
ANTHROPIC_API_KEY=sk-ant-xxxxx
# 可选：ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------- Cloudflare Tunnel（仅部署需要）----------
TUNNEL_TOKEN=

# ---------- 数据库（Postgres 容器；不设则回退本地文件）----------
POSTGRES_USER=langlearn
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=langlearn
# 容器内连接用服务名 postgres；本地隧道跑迁移时改成 localhost:5433
DATABASE_URL=postgresql://langlearn:change-me-strong-password@postgres:5432/langlearn

# ---------- 对象存储 S3（视频；不设则回退本地 recordings/）----------
BLOB_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
# AWS 凭证：
#   - EC2 + IAM 实例角色（推荐/生产）：留空！SDK 自动经 IMDS 取临时凭证。
#   - 本地或无角色环境才需要下面两行：
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
