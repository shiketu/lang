# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ----- Dependencies -----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Next.js -----
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ----- Testing / Coverage -----
/coverage

# ----- Environment files (NEVER commit secrets) -----
.env
.env.*
!.env.example
!.env.local.example

# ----- Logs -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ----- OS / Editor -----
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ----- Vercel / Deploy -----
.vercel

# ----- PWA icon source (large/copyrighted; generated icons are committed) -----
/public/icons/source.*
/public/icons/_*.png

# ----- User data (personal learning content — NOT code) -----
# Keep directory structure via .gitkeep, ignore actual data files.
/content/**/*
!/content/**/.gitkeep
/recordings/*
!/recordings/.gitkeep
